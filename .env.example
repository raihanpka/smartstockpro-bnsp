APP_NAME="SmartStock Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Development lokal (SQLite, tanpa setup apapun):
#   DB_CONNECTION=sqlite
#
# Production / Docker (PostgreSQL):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartstock_pro
DB_USERNAME=postgres
DB_PASSWORD=secret

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Queue ─────────────────────────────────────────────────────────────────────
# sync     = in-memory, langsung dieksekusi, tanpa worker — cocok untuk development
# database = background jobs via tabel `jobs` — cocok untuk production / Docker
QUEUE_CONNECTION=sync

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=database

# ── Storage ───────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────────────
# Gunakan 'log' saat development (tidak benar-benar kirim email)
# Ganti ke 'smtp' dan isi kredensial di production
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@smartstockpro.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
